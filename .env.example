# =====================================================
# YouTube Compass 根目录环境变量配置
# 本文件供 docker-compose 使用。后端自身配置请编辑 backend/.env
# 复制本文件为 .env 并填入实际值：cp .env.example .env
# =====================================================

# --------------------------------------------------
# 数据库（MySQL）— docker-compose.mysql 服务使用
# --------------------------------------------------
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=creator_saas
MYSQL_PORT=3306
# 完整连接串（docker-compose 会引用上面的变量拼接）
DATABASE_URL=mysql+asyncmy://your_mysql_user:your_mysql_password@mysql:3306/creator_saas

# --------------------------------------------------
# JWT 认证
# --------------------------------------------------
# 必填：生产环境务必使用强随机字符串（>= 32 字符）
SECRET_KEY=your-secret-key-here
# 可选：与 JWT 分离的字段加密盐；未设置时回退使用 SECRET_KEY
FIELD_ENCRYPTION_SECRET=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --------------------------------------------------
# CORS 跨域
# --------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------
# YouTube Data API v3
# --------------------------------------------------
YOUTUBE_API_KEY=

# --------------------------------------------------
# 火山引擎 CV（图片修复 / Inpainting）
# --------------------------------------------------
VOLC_CV_ACCESS_KEY_ID=
VOLC_CV_SECRET_ACCESS_KEY=
VOLC_CV_REGION=cn-north-1
VOLC_CV_HOST=
VOLC_CV_INPAINT_REQ_KEY=i2i_inpainting

# --------------------------------------------------
# 阿里云 OSS 对象存储
# --------------------------------------------------
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_ROLE_ARN=
ALIYUN_REGION_ID=
ALIYUN_OSS_BUCKET_NAME=
ALIYUN_OSS_ENDPOINT=
# 对外访问时替换默认 OSS 域名（须与桶绑定 CDN/自定义域名一致）
ALIYUN_CUSTOM_DOMAIN=

# --------------------------------------------------
# 腾讯云 COS 对象存储
# --------------------------------------------------
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_BUCKET=
TENCENT_CUSTOM_DOMAIN=

# --------------------------------------------------
# 存储提供商切换
# --------------------------------------------------
# 可选值：ALIYUN | TENCENT（不配置则默认 TENCENT）
ACTIVE_STORAGE_PROVIDER=TENCENT

# --------------------------------------------------
# Google OAuth（可选，用于 Google 账号登录）
# --------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --------------------------------------------------
# SMTP 邮件服务
# --------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=true

# --------------------------------------------------
# 前端站点地址
# --------------------------------------------------
FRONTEND_BASE_URL=http://localhost:5173

# --------------------------------------------------
# yt-dlp 下载代理（可选，如 http://127.0.0.1:7890）
# --------------------------------------------------
DOWNLOAD_PROXY=