# =====================================================
# YouTube Compass 根目录环境变量
# 本文件仅供 docker-compose ${VAR:?} 插值使用
# 完整配置请参考 backend/.env.example 并复制为 backend/.env
# =====================================================

# --------------------------------------------------
# JWT 认证（docker-compose 必需插值）
# --------------------------------------------------
# 必填：生产环境务必使用强随机字符串（>= 32 字符）
SECRET_KEY=your-secret-key-here