# =====================================================
# YouTube Compass 前端环境变量配置
# 复制本文件为 .env 并填入实际值：cp .env.example .env
# =====================================================

# --------------------------------------------------
# 后端 API 地址
# --------------------------------------------------
# 指向后端服务地址，不含 /api 后缀（apiClient 会自动拼接）
VITE_API_BASE_URL=http://localhost:8000

# --------------------------------------------------
# 功能开关（Feature Flags）
# 创作者工具默认关闭，设为 "true" 启用
# --------------------------------------------------
VITE_FEATURE_INSPIRATION=false
VITE_FEATURE_AI_CREATOR=false
VITE_FEATURE_SOP=false
VITE_FEATURE_ASSETS=false
VITE_FEATURE_KNOWLEDGE=false
VITE_FEATURE_FEISHU=false
