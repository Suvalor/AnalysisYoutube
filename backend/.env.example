# =====================================================
# YouTube Compass 后端环境变量配置
# 复制本文件为 .env 并填入实际值：cp .env.example .env
# =====================================================

# --------------------------------------------------
# 数据库（远程 MySQL）
# --------------------------------------------------
MYSQL_USER=your_mysql_user
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=your-remote-mysql-host
MYSQL_PORT=3306
MYSQL_DB=analysisYoutube
# 后端自动拼接 DATABASE_URL，无需手动配置
# 如需覆盖：DATABASE_URL=mysql+asyncmy://user:password@host:port/dbname

# --------------------------------------------------
# JWT 认证
# --------------------------------------------------
# 必填：生产环境务必使用强随机字符串（>= 32 字符），可用：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here
# 可选：与 JWT 分离的字段加密盐；未设置时回退使用 SECRET_KEY
FIELD_ENCRYPTION_SECRET=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --------------------------------------------------
# CORS 跨域
# --------------------------------------------------
# 前端地址，多个用英文逗号分隔
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# --------------------------------------------------
# 火山引擎 CV（图片修复 / Inpainting）
# --------------------------------------------------
VOLC_CV_ACCESS_KEY_ID=
VOLC_CV_SECRET_ACCESS_KEY=
VOLC_CV_REGION=cn-north-1
VOLC_CV_HOST=
VOLC_CV_INPAINT_REQ_KEY=i2i_inpainting

# --------------------------------------------------
# 阿里云 OSS 对象存储
# --------------------------------------------------
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_ROLE_ARN=
ALIYUN_REGION_ID=cn-guangzhou
ALIYUN_OSS_BUCKET_NAME=
ALIYUN_OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
ALIYUN_CUSTOM_DOMAIN=

# --------------------------------------------------
# 腾讯云 COS 对象存储
# --------------------------------------------------
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_BUCKET=
TENCENT_CUSTOM_DOMAIN=

# --------------------------------------------------
# 存储提供商切换
# --------------------------------------------------
ACTIVE_STORAGE_PROVIDER=TENCENT

# --------------------------------------------------
# Google OAuth（可选）
# --------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --------------------------------------------------
# SMTP 邮件服务（注册验证码 / 密码重置）
# --------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=true

# --------------------------------------------------
# 前端站点地址（用于生成密码重置链接）
# --------------------------------------------------
FRONTEND_BASE_URL=http://localhost:5175

# --------------------------------------------------
# yt-dlp 下载代理（可选）
# --------------------------------------------------
DOWNLOAD_PROXY=